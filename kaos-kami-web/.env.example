# --- App ---
NEXT_PUBLIC_SITE_URL=https://kaoskami.com

# --- Database (Turso libSQL Edge SQLite) ---
DATABASE_URL="libsql://DB-MU.aws-ap-northeast-1.turso.io"
TURSO_DATABASE_URL="libsql://DB-MU.aws-ap-northeast-1.turso.io"
# JANGAN tulis token asli di sini — pakai .env.local (gitignored) & wrangler secret di prod.
TURSO_AUTH_TOKEN="isi-dari-turso-db-tokens"

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET="ganti-dengan-random-32-char-minimum"
BETTER_AUTH_URL="https://kaoskami.com"
# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Fonnte OTP cuma saat checkout (hemat quota 993) — daftar pakai Google/Email tanpa WA
FONNTE_TOKEN_OTP="pakai FONNTE_TOKEN yang sama"

# --- Storage (Cloudflare R2) — nama var HARUS persis ini (kode r2.ts bacanya ini) ---
R2_BUCKET_NAME=kaos-kami-assets
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# --- Cloudflare ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Payments (Duitku Payment Gateway) ---
# WAJIB via env lokal (.env.local, JANGAN commit) & prod via `wrangler secret put`.
# Contoh: npx wrangler secret put DUITKU_MERCHANT_CODE
#         npx wrangler secret put DUITKU_API_KEY
DUITKU_MERCHANT_CODE=""
DUITKU_API_KEY=""
DUITKU_ENV="sandbox" # "sandbox" | "production"

# --- Shipping Hyperlocal Makassar (tanpa API) ---
SHOP_WORKSHOP_ADDRESS="Workshop Kaos Kami, Makassar, Sulawesi Selatan"
SHOP_CONTACT_WHATSAPP="6281244002026"

# --- Notifications (Fonnte WA) ---
FONNTE_TOKEN="xxx"
# Paksa mode mock WA (dev/QA saja, jangan di prod):
# WHATSAPP_FORCE_MOCK="true"

# --- Cloudflare Turnstile (anti-bot checkout) ---
# NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
# CLOUDFLARE_TURNSTILE_SECRET_KEY=

# --- Mobile (dibaca aplikasi Capacitor, bukan web) ---
# NEXT_PUBLIC_API_URL=https://kaos-kami-3d.hengkisetiawan461.workers.dev

# --- Analytics ---
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# --- Monitoring (optional) ---
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
