# --- App ---
NEXT_PUBLIC_SITE_URL=https://kaoskami.biz.id
# --- Database (Turso libSQL Edge SQLite) ---
DATABASE_URL="libsql://DB-MU.aws-ap-northeast-1.turso.io"
TURSO_DATABASE_URL="libsql://DB-MU.aws-ap-northeast-1.turso.io"
# JANGAN tulis token asli di sini — pakai .env.local (gitignored) & wrangler secret di prod.
TURSO_AUTH_TOKEN="isi-dari-turso-db-tokens"

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET="ganti-dengan-random-32-char-minimum"
BETTER_AUTH_URL="https://kaoskami.biz.id"
# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Fonnte OTP cuma saat checkout (hemat quota 993) — daftar pakai Google/Email tanpa WA.
# Satu token untuk semua (kode hanya baca FONNTE_TOKEN).
FONNTE_TOKEN="xxx"

# Cron internal (sweep PENDING + backup). Wajib SAMA dengan yang dipasang via
# `wrangler secret put CRON_SECRET` + URL cron-job.org .../api/cron/*.
CRON_SECRET="ganti-dengan-random-32-char-minimum"

# --- Storage (Cloudflare R2) — nama var HARUS persis ini (kode r2.ts bacanya ini) ---
R2_BUCKET_NAME=kaos-kami-assets
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# --- Cloudflare ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Payments (Duitku — LEGACY / NONAKTIF permanen, JANGAN pakai untuk order baru) ---
# Webhook Duitku menjawab 410 Gone + audit-only tanpa efek DB (RUNBOOK §1).
# Vars di bawah dipertahankan HANYA sebagai jejak audit; JANGAN set di env/prod baru.
# Contoh: npx wrangler secret put DUITKU_MERCHANT_CODE
#         npx wrangler secret put DUITKU_API_KEY
DUITKU_MERCHANT_CODE=""
DUITKU_API_KEY=""
DUITKU_ENV="sandbox" # "sandbox" | "production"

# --- Payments (iPaymu — JALUR AKTIF, Direct QRIS 100% in-app) ---
# WAJIB via env lokal (.env.local, JANGAN commit) & prod via `wrangler secret put`.
# Contoh: npx wrangler secret put IPAYMU_VA
#         npx wrangler secret put IPAYMU_API_KEY
IPAYMU_VA=""
IPAYMU_API_KEY=""
IPAYMU_ENV="sandbox" # "sandbox" | "production"

# --- Shipping Hyperlocal Makassar (tanpa API) ---
SHOP_WORKSHOP_ADDRESS="Jl. Galangan Kapal Lrg. Permandian 1, Kaluku Bodoa, Kec. Tallo, Kota Makassar, Sulawesi Selatan"
SHOP_CONTACT_WHATSAPP="6281244002026"
SHOP_POSTAL_CODE="90211"

# --- AgenWebsite Rate API (ongkir live luar kota, opsional) ---
# Tanpa key: quote pakai tabel ExpeditionZone (estimasi). Pasang via:
#   npx wrangler secret put AGENWEBSITE_RATE_API_KEY   (prod)
AGENWEBSITE_RATE_API_KEY=""
# AGENWEBSITE_SANDBOX="true" # pakai key awk_test_... saat pengembangan

# --- Notifications (Fonnte WA — token di § atas, JANGAN duplikat di sini) ---
# Paksa mode mock WA (dev/QA saja, jangan di prod):
# WHATSAPP_FORCE_MOCK="true"

# --- Cloudflare Turnstile (anti-bot checkout) ---
# NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
# CLOUDFLARE_TURNSTILE_SECRET_KEY=

# --- Kill-switch checkout darurat (default WAJIB verifikasi; `false` hanya darurat, JANGAN commit nilainya) ---
# CHECKOUT_OTP_REQUIRED=false # lewati gerbang OTP (darurat Fonnte mati)
# TURNSTILE_ENFORCE=false # lewati Turnstile (darurat)

# --- Feature flags UI (default true bila unset; "false"=rollback darurat, lalu restart/redeploy) ---
# NEXT_PUBLIC_GIZMO_SVG="true" # false → gizmo <Html> lama (DecalGizmoHtml.tsx)
# NEXT_PUBLIC_CHECKOUT_V2="true" # false → checkout legacy 1-langkah (CheckoutModalLegacy.tsx)

# --- Intip-OTP OPSI-1 (E2E regresi, keputusan owner 2026-09-24; MATI default!) ---
# Aktif HANYA bila ketiganya: nilai persis "YA" + DUITKU_ENV=sandbox (BUKAN
# production) + nomor terdaftar di bawah. JANGAN set di prod (route tolak 404
# di sana). JANGAN commit nilai asli — isi di .env.local / wrangler secret DEV.
# HAPUS total saat E2E 100% (lihat PANDUAN-RUNNER §14).
# E2E_ALLOW_OTP_PEEK="YA"
# E2E_OTP_PEEK_NUMBERS="" # koma, cth: "0895803463032,0882020685076" (kanonis 62 otomatis)

# --- Mobile (dibaca aplikasi Capacitor, bukan web) ---
# NEXT_PUBLIC_API_URL=https://kaoskami.biz.id

# --- Analytics ---
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# --- Monitoring (optional) ---
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# --- Email (Resend; WAJIB via secret bila fitur email dipakai di prod) ---
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@kaoskami.biz.id

# --- Backup bucket override (default kaos-kami-backups bila kosong) ---
# R2_BACKUP_BUCKET_NAME=kaos-kami-backups

# --- Shop opsional (default Makassar; eksplisitkan bila pindah workshop) ---
# SHOP_LAT=
# SHOP_LON=
# NEXT_PUBLIC_APK_URL=https://pub-xxx.r2.dev/aplikasi/kaos-kami.apk

# --- Sosial & kontak publik (opsional; fallback di src/lib/shop.ts, JANGAN commit nilai asli) ---
# NEXT_PUBLIC_FB_COMMUNITY_URL=https://www.facebook.com/groups/kaoskamimakassar
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/kaoskami.makassar
# NEXT_PUBLIC_MAPS_URL=https://maps.google.com/?q=Jl.+Galangan+Kapal,+Lrg.+Permandian+1,+Kaluku+Bodoa,+Tallo,+Makassar
# NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@kaoskami
# SHOP_EMAIL=hengkisetiawan461@gmail.com
# SHOP_SUPPORT_EMAIL=support@kaoskami.biz.id

# --- Routing gateway pembayaran (dibaca src/app/api/checkout/route.ts; default ipaymu bila unset) ---
# PAYMENT_GATEWAY_PROVIDER=ipaymu

# --- Auth trusted origins tambahan (koma-separated, mis. staging; workers.dev selalu dibuang, lihat src/lib/auth.ts) ---
# TRUSTED_ORIGINS=

# --- Rate-limit KV binding (wrangler kv_namespaces, BUKAN string env; lihat src/lib/security/rateLimiter.ts) ---
# RATE_LIMIT_KV= (binding KV via wrangler.jsonc, jangan isi string di sini)
