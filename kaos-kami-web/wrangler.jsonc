{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "kaos-kami-3d",
	"compatibility_date": "2026-08-31",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "kaos-kami-3d"
		}
	],
	"r2_buckets": [
		// Use R2 incremental cache
		// See https://opennext.js.org/cloudflare/caching
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			// Create the bucket before deploying
			// You can change the bucket name if you want
			// See https://developers.cloudflare.com/workers/wrangler/commands/#r2-bucket-create
			"bucket_name": "kaos-kami-3d-opennext-cache"
		}
	],
	// Rate-limit lintas-isolate AKTIF (KV dibuat 07 Sep 2026).
	"kv_namespaces": [{ "binding": "RATE_LIMIT_KV", "id": "6431b2b40c0b4de0afb51e3d25faf53d" }],
	// NOTE (13 Sep 2026): binding Cloudflare Images SENGAJA dihapus — next.config
	// memakai images.unoptimized:true (benar di Workers, tanpa loader kustom
	// binding hanya jadi permission menganggur). Kembalikan + pasang custom
	// loader bila suatu saat pindah ke Cloudflare Images.
	"vars": {
		"NEXT_PUBLIC_SITE_URL": "https://kaoskami.biz.id",
		"NEXT_PUBLIC_GA_MEASUREMENT_ID": "G-W3VHM4G0TW",
		"BETTER_AUTH_URL": "https://kaoskami.biz.id",
		"DATABASE_URL": "libsql://kaos-kami-hengki164.aws-ap-northeast-1.turso.io",
		"TURSO_DATABASE_URL": "libsql://kaos-kami-hengki164.aws-ap-northeast-1.turso.io",
		"CLOUDFLARE_ACCOUNT_ID": "6c660b71ad4e72f3bc343252a7c5e825",
		"R2_BUCKET_NAME": "kaos-kami-assets",
		"R2_PUBLIC_URL": "https://pub-5746f36a46904edc8425ecd721b0bfdc.r2.dev",
		// W1 (21 Sep 2026, KOREKSI): GOOGLE_CLIENT_ID publik → vars. DUITKU_ENV
		// KEMBALI ke secrets (revert): nilainya WAJIB beda per env (sandbox
		// lokal vs production prod) — vars yg ter-commit akan memaksa satu
		// nilai untuk semua deploy = BAHAYA (prod bisa baca sandbox).
		// Site key Turnstile dibaca client dari build-time .env.local (baked).
		// JANGAN taruh di vars (nilai kosong menimpa secret — insiden 21 Sep).
		// GOOGLE_CLIENT_ID + TURNSTILE_SITE_KEY = publik (OAuth/sitekey terlihat
		// di redirect/HTML) — BOLEH di vars, TAPI wajib nilai ASLI, jangan "".
		// Dipulihkan 21 Sep 2026 pasca-insiden overwrite (secret put 10053).
		"GOOGLE_CLIENT_ID": "172850071575-k1ctsjr6gdjuk4j873uc8pbkotf40017.apps.googleusercontent.com",
		"NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY": "0x4AAAAAAErqdIfhQY0ShwKU",
		"SHOP_POSTAL_CODE": "90211",
		"R2_BACKUP_BUCKET_NAME": "kaos-kami-backups"
	},
	"secrets": {
		"required": [
	"TURSO_AUTH_TOKEN",
		"DUITKU_MERCHANT_CODE",
		"DUITKU_API_KEY",
		"DUITKU_ENV",
		"CLOUDFLARE_API_TOKEN",
			"CLOUDFLARE_TURNSTILE_SECRET_KEY",
			"BETTER_AUTH_SECRET",
			"FONNTE_TOKEN",
	"CRON_SECRET",
	"AGENWEBSITE_RATE_API_KEY",
	"GOOGLE_CLIENT_SECRET"
]
	// Catatan 21 Sep 2026: GOOGLE_CLIENT_ID (publik) pindah ke vars dgn nilai
	// asli; JANGAN masukkan ke required (secret put 10053 + konflik binding).
	// Catatan 21 Sep 2026: RESEND_API_KEY SENGAJA di luar required agar deploy
	// tak gagal bila fitur email dimatikan; bila register-email dipakai di prod,
	// pasang via `wrangler secret put RESEND_API_KEY` (kode gagal jujur 503 bila kosong).
	}
}