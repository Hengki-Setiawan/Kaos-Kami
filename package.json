{
  "name": "kaos-kami-project",
  "version": "2.1.0",
  "private": true,
  "workspaces": [
    "kaos-kami-web",
    "kaos-kami-mobile"
  ],
  "scripts": {
    "web:dev": "npm --workspace=kaos-kami-web run dev",
    "web:build": "npm --workspace=kaos-kami-web run build",
    "web:deploy": "npm --workspace=kaos-kami-web run deploy",
    "web:typecheck": "npm --workspace=kaos-kami-web run typecheck",
    "mobile:dev": "npm --workspace=kaos-kami-mobile run dev",
    "mobile:build": "npm --workspace=kaos-kami-mobile run build",
    "mobile:typecheck": "npx tsc --noEmit -p kaos-kami-mobile/tsconfig.json",
    "mobile:sync": "npm --workspace=kaos-kami-mobile run cap:sync",
    "mobile:android": "npm --workspace=kaos-kami-mobile run cap:open:android",
    "mobile:ios": "npm --workspace=kaos-kami-mobile run cap:open:ios",
    "sync:assets": "node scripts/sync-assets.mjs"
  },
  "dependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
